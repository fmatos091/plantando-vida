# ===================== TEMPLATE DE VARIÁVEIS DE AMBIENTE =====================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env com valores reais.

SECRET_KEY=troque-por-uma-chave-aleatoria-longa

ADMIN_LOGIN=seu_login_admin
ADMIN_SENHA=sua_senha_admin_segura

# Super Admin — nível máximo, gerencia todos os tenants/clientes
# NUNCA armazenado no banco — somente em variável de ambiente
SUPER_ADMIN_LOGIN=seu_login_super_admin
SUPER_ADMIN_SENHA=sua_senha_super_admin_segura

# Brevo (antigo Sendinblue) — 300 emails/dia gratis, sem dominio proprio necessario
# Obtenha em: https://app.brevo.com → Configuracoes → Chaves e tokens → Chave SMTP
BREVO_LOGIN=seu_email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxx
BREVO_FROM=Plantando Vida <projetoplantandovida2026@gmail.com>

APP_URL=http://localhost:5000

# CRON_SECRET — token que autoriza o endpoint /admin/cron/lembrete-rega.
# Gere um valor aleatorio longo e configure o mesmo valor no servico de cron externo
# (ex: cron-job.org) como header "X-Cron-Token" ou query string "?token=".
CRON_SECRET=troque-por-um-token-aleatorio-longo

# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Cloudinary — armazenamento de imagens persistente (não perde no redeploy)
# Obtenha em: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Gemini (Google AI Studio) — identificacao de especies por foto ("Descobrir Especie" na home)
# Cadastro imediato e gratuito, sem lista de espera.
# Obtenha em: https://aistudio.google.com/apikey → login com conta Google → Create API key
# Sem esta chave o botao continua visivel, mas avisa que a ferramenta nao esta ativa.
GEMINI_API_KEY_ESPECIES=sua_chave_gemini
