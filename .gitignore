# Arquivos de cache do Python — gerados automaticamente, não devem ir ao repositório
__pycache__/
*.pyc
*.pyo

# Banco de dados local — cada ambiente terá o seu próprio
database.db

# Ambiente virtual Python (caso seja criado futuramente)
venv/
env/

# Variáveis de ambiente com credenciais — nunca commitar
.env

# Configurações de editores
.vscode/
.idea/

# Fotos de plantios enviadas pelos usuários (não devem ir ao repositório)
# O arquivo .gitkeep dentro da pasta garante que o diretório seja versionado
static/uploads/*
!static/uploads/.gitkeep
